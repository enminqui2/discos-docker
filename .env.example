# Copia este archivo como .env y cambia la contraseña.
# Docker Compose y la aplicación leen este mismo archivo.

# Usuario administrador que se crea en MongoDB la primera vez que arranca el contenedor
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=cambia_esta_clave

# Cadena de conexión que usa la aplicación (usa el mismo usuario y contraseña de arriba)
MONGODB_URI=mongodb://admin:cambia_esta_clave@localhost:27017/discos?authSource=admin

# Puerto de la aplicación web
PORT=3000
